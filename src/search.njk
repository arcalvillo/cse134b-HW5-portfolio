---
layout: layouts/base.njk
title: Search
description: Search the contents of this site.
permalink: /search/
eleventyExcludeFromCollections: true
---
<h1>Search</h1>

<form id="search-form" role="search">
  <p class="field">
    <label for="search-input">Search this site</label>
    <input type="search" id="search-input" name="q" autocomplete="off">
  </p>
  <button type="submit">Search</button>
</form>

<p id="search-status" class="lede" aria-live="polite"></p>

<ul id="search-results" class="card-list"></ul>

<template id="search-result">
  <li class="card">
    <h2><a class="result-title" href="#"></a></h2>
    <p class="result-excerpt"></p>
  </li>
</template>

<noscript>
  <p>
    Search needs JavaScript because the index is queried in your browser rather
    than on a server. You can browse the full list of pages on this site in the
    <a href="/sitemap.xml">sitemap</a>.
  </p>
</noscript>

<script type="module" src="/js/search.js"></script>