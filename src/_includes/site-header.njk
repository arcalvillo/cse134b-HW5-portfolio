<header class="site-header" data-pagefind-ignore> {#pagefind ignore header#}
  <div class="site-header__bar">
    <p class="site-header__name"><a href="/">{{ site.title }}</a></p>
    <p class="site-header__tagline">{{ site.tagline }}</p>
  </div>

  <nav aria-label="Main">
    <ul class="nav-list">
      {% for item in site.nav %}
        <li>
          <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.text }}</a>
        </li>
      {% endfor %}
      {# A lot of CS portfolios have a download icon in the top-right corner so I added it #}
      <li>
        <a class="icon-link" href="/resume.pdf" download>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span class="visually-hidden">Download resume (PDF)</span>
        </a>
      </li>
    </ul>
  </nav>

  {# Presentation controls grouped together so the header wraps as one unit
     instead of each control reflowing independently on narrow screens #}
  <div class="site-header__controls">

    <fieldset id="theme-picker" class="theme-picker" hidden>
      <legend>Theme</legend>
      <div class="theme-picker__options">
        <span>
          <input type="radio" id="theme-light" name="theme" value="light">
          <label for="theme-light">Light</label>
        </span>
        <span>
          <input type="radio" id="theme-dark" name="theme" value="dark">
          <label for="theme-dark">Dark</label>
        </span>
        <span>
          <input type="radio" id="theme-system" name="theme" value="system" checked>
          <label for="theme-system">System</label>
        </span>
      </div>
    </fieldset>
    
    {#----------------For Dark Academia theme---------------------------#}
    <fieldset id="aesthetic-controls" class="theme-picker" hidden>
      <legend>Aesthetic</legend>
      <div class="theme-picker__options">
        <span class="switch">
          <input type="checkbox" id="aesthetic-input" class="switch__input">
          <label for="aesthetic-input" class="switch__label">Dark Academia</label>
        </span>

        <span class="switch switch--reading">
          <input type="checkbox" id="reading-input" class="switch__input">
          <label for="reading-input" class="switch__label">Easy-to-Read font</label>
        </span>
      </div>
    </fieldset>
  </div>
</header>