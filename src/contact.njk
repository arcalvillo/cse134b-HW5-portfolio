---
layout: base.njk
title: Contact
description: Get in touch with Arrissa Calvillo.
permalink: /contact/
---
<h1>Get in touch</h1>

<section>
  <h2>Send a message</h2>
  <p>Send me a message using the form below, or use the contact details underneath it.</p>

  <form action="/contact/" method="post">
    <fieldset>
      <legend>Send a message</legend>

      <p class="field">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required maxlength="80" autocomplete="name">
      </p>

      <p class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required maxlength="120" autocomplete="email">
      </p>

      <p class="field">
        <label for="subject">Subject</label>
        <input type="text" id="subject" name="subject" maxlength="120">
      </p>

      <p class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="6" required minlength="10" maxlength="2000"></textarea>
      </p>

      <button type="submit">Send message</button>
    </fieldset>
  </form>
</section>

<section>
  <h2>Contact info</h2>
  <ul>
    <li>Email: <a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
    <li>Located: {{ site.location }}</li>
  </ul>
</section>

<section>
  <h2>Elsewhere</h2>
  <ul>
    {% for item in site.social %}
      <li><a href="{{ item.url }}">{{ item.text }}</a></li>
    {% endfor %}
  </ul>
</section>
